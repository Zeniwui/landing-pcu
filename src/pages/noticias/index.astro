---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('noticias');
// Ordenar por fecha descendente
const sortedNews = allNews.sort((a, b) => new Date(b.data.fecha).getTime() - new Date(a.data.fecha).getTime());
---

<Layout
  title="Noticias y Crónicas | PCU UniOvi"
  description="Resultados de competiciones, crónicas de viajes y avisos de la Asociación de Programación Competitiva de la Universidad de Oviedo."
  currentPath="/noticias"
>
  <main class="news-page">
    <section class="section-padding" style="background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);">
      <div class="container" style="max-width: 960px;">
        <div class="breadcrumbs">
          <a href="/">Inicio</a> / <span>Noticias</span>
        </div>

        <div class="section-head" style="margin-top: 1rem;">
          <span class="section-tag">Actualidad</span>
          <h1 class="section-title">Noticias y crónicas</h1>
          <p class="section-lead">
            Resultados de competiciones, crónicas de los viajes a certámenes y avisos sobre las actividades del club.
          </p>
        </div>

        <div class="news-list" style="margin-top: 2.5rem; display: flex; flex-direction: column; gap: 1.75rem;">
          {sortedNews.map((post) => (
            <article class="news-card">
              <div class="news-meta">
                <span class="news-date">{post.data.fecha}</span>
                <span class="meta-dot">·</span>
                <span class="news-category">{post.data.categoria}</span>
                <span class="meta-dot">·</span>
                <span>Por {post.data.autor}</span>
              </div>
              <h2 class="news-title">
                <a href={`/noticias/${post.id}`}>{post.data.titulo}</a>
              </h2>
              <p class="news-desc">{post.data.descripcion}</p>
              <div style="margin-top: 1rem;">
                <a href={`/noticias/${post.id}`} class="btn-read-article">
                  Leer crónica completa &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .breadcrumbs {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .breadcrumbs a {
    color: var(--uniovi-blue);
    text-decoration: underline;
  }
  .news-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    padding: 2rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .news-card:hover {
    transform: translateY(-2px);
    border-color: var(--uniovi-blue);
    box-shadow: var(--shadow-card);
  }
  .news-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }
  .news-category {
    color: var(--uniovi-blue);
    font-weight: 600;
  }
  .news-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink-primary);
    margin-bottom: 0.75rem;
  }
  .news-title a:hover {
    color: var(--uniovi-blue);
    text-decoration: underline;
  }
  .news-desc {
    color: var(--ink-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }
  .btn-read-article {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--uniovi-blue);
  }
</style>
