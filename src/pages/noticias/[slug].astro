---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('noticias');
  return news.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.titulo} | PCU UniOvi`}
  description={post.data.descripcion}
  currentPath="/noticias"
>
  <main class="news-detail-page">
    <article class="section-padding">
      <div class="container" style="max-width: 840px;">
        <!-- MIGA DE PAN -->
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <a href="/">Inicio</a> / <a href="/noticias">Noticias</a> / <span>{post.data.titulo}</span>
        </nav>

        <header class="post-header">
          <div class="post-meta">
            <span class="badge-category">{post.data.categoria}</span>
            <span class="post-date">{post.data.fecha}</span>
            <span class="meta-dot">·</span>
            <span>Por {post.data.autor}</span>
          </div>

          <h1 class="post-title">{post.data.titulo}</h1>
          <p class="post-lead">{post.data.descripcion}</p>
        </header>

        <div class="markdown-body">
          <Content />
        </div>

        <div class="post-footer-nav" style="margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--border-hairline);">
          <a href="/noticias" class="btn-secondary">&larr; Volver a todas las noticias</a>
        </div>
      </div>
    </article>
  </main>
</Layout>

<style>
  .breadcrumbs {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-muted);
    margin-bottom: 2rem;
  }
  .breadcrumbs a {
    color: var(--uniovi-blue);
    text-decoration: underline;
  }
  .post-header {
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-muted);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .badge-category {
    background: var(--uniovi-blue-tint);
    color: var(--uniovi-blue);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
  }
  .post-title {
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink-primary);
    margin-bottom: 1rem;
  }
  .post-lead {
    font-size: 1.18rem;
    color: var(--ink-secondary);
    line-height: 1.65;
  }
  .markdown-body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--ink-secondary);
  }
  .markdown-body :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--ink-primary);
    margin: 2.5rem 0 1rem;
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 0.5rem;
  }
  .markdown-body :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--ink-primary);
    margin: 1.75rem 0 0.75rem;
  }
  .markdown-body :global(p) {
    margin-bottom: 1.25rem;
  }
  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
</style>
