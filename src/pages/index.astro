---
import Layout from '../layouts/Layout.astro';
import Scoreboard from '../components/Scoreboard.astro';
import ContestCard from '../components/ContestCard.astro';
import { getCollection } from 'astro:content';

const allActivities = await getCollection('actividades');
// Destacados para la landing principal
const featuredContests = allActivities.slice(0, 6);
---

<Layout title="PCU UniOvi | Asociación de Programación Competitiva Universitaria">
  <main>
    <!-- SECCIÓN HERO: EDITORIAL CON SCOREBOARD DE COMPETICIÓN -->
    <section id="hero" class="hero">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-editorial">
            <div class="hero-meta-bar">
              <span class="badge-uniovi">ESCUELA DE INFORMÁTICA · UNIOVI</span>
              <span class="meta-divider">/</span>
              <span class="meta-status">
                <span class="status-dot"></span> Temporada 2026 Activa
              </span>
            </div>

            <h1 class="hero-title">
              Pensar en <span class="accent-text">O(1)</span>.<br>
              Programación y algoritmia en equipo.
            </h1>

            <p class="hero-description">
              Somos la <strong>Asociación de Programación Competitiva Universitaria (PCU)</strong> de la Universidad de Oviedo. Nos reunimos cada semana para practicar estructuras de datos, resolver problemas de concurso y preparar competiciones como AdaByron o SWERC.
            </p>

            <div class="hero-actions">
              <a href="/actividades" class="btn-primary">Ver Actividades</a>
              <a href="#contacto" class="btn-secondary">Unirse a la Asociación</a>
            </div>

            <div class="hero-stats-row">
              <div class="stat-item">
                <span class="stat-value">5 Horas</span>
                <span class="stat-label">Formato oficial ICPC por equipo de 3</span>
              </div>
              <div class="stat-item">
                <span class="stat-value">{allActivities.length}+ Actividades</span>
                <span class="stat-label">Competiciones y talleres</span>
              </div>
              <div class="stat-item">
                <span class="stat-value">Semanal</span>
                <span class="stat-label">Entrenamientos prácticos</span>
              </div>
            </div>
          </div>

          <!-- MARCADOR EN VIVO DE COMPETICIÓN -->
          <Scoreboard />
        </div>
      </div>
    </section>

    <!-- SECCIÓN: CONCURSOS Y COMPETICIONES (DINÁMICO CON ASTRO) -->
    <section id="concursos" class="section-padding">
      <div class="container">
        <div class="section-head">
          <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
            <div>
              <span class="section-tag">Competiciones</span>
              <h2 class="section-title">Concursos y Competiciones</h2>
              <p class="section-lead">
                Participamos en certámenes universitarios de algoritmia y programación a nivel regional, nacional e internacional.
              </p>
            </div>
            <a href="/actividades" class="btn-secondary" style="font-size: 0.88rem; padding: 0.65rem 1.25rem;">
              Ver todas las actividades ({allActivities.length}) &rarr;
            </a>
          </div>
        </div>

        <div class="contests-grid">
          {featuredContests.map((item) => (
            <ContestCard
              slug={item.id}
              titulo={item.data.titulo}
              descripcion={item.data.descripcion}
              ambito={item.data.ambito}
              estado={item.data.estado}
              formato={item.data.formato}
              lugar={item.data.lugar}
              fecha={item.data.fecha}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- SECCIÓN: ACTIVIDADES FORMATIVAS & IMPACTO -->
    <section id="actividades" class="section-padding" style="background-color: var(--bg-surface);">
      <div class="container">
        <div class="section-head">
          <span class="section-tag">Comunidad</span>
          <h2 class="section-title">Nuestras Actividades</h2>
          <p class="section-lead">
            Además de competir, organizamos entrenamientos semanales en la Escuela de Informática y talleres de divulgación en institutos.
          </p>
        </div>

        <div class="activities-container">
          <!-- Actividad 1: Entrenamientos Técnicos -->
          <article class="activity-pane featured">
            <span class="pane-badge">Formación Continua</span>
            <h3 class="pane-title">Entrenamientos Algorítmicos Semanales</h3>
            <p class="pane-text">
              Nos reunimos en los laboratorios de la Escuela de Ingeniería Informática para resolver problemas de concurso, comentar soluciones y aprender nuevas técnicas.
            </p>
            <ul class="activity-checklist">
              <li>
                <span class="check-bullet">✓</span>
                <span>Grafos (Dijkstra, BFS/DFS), programación dinámica y estructuras de datos como árboles de segmentos o DSU.</span>
              </li>
              <li>
                <span class="check-bullet">✓</span>
                <span>Análisis de complejidad temporal y espacial para encajar soluciones en los límites de tiempo de cada problema.</span>
              </li>
              <li>
                <span class="check-bullet">✓</span>
                <span>Estrategia de equipo para repartir problemas y compartir un único teclado durante cinco horas.</span>
              </li>
            </ul>
            <div style="margin-top: 1.5rem;">
              <a href="/actividades/entrenamientos-semanales" class="btn-secondary" style="font-size: 0.82rem; padding: 0.5rem 1rem;">
                Ver temario y horarios &rarr;
              </a>
            </div>
          </article>

          <!-- Actividad 2: Impacto Social & STEM -->
          <article class="activity-pane">
            <span class="pane-badge">Vocaciones Científicas</span>
            <h3 class="pane-title">Talleres STEM en Colegios e Institutos</h3>
            <p class="pane-text">
              Visitamos colegios e institutos asturianos para enseñar conceptos básicos de informática mediante retos prácticos, lógica y juegos sin pantalla.
            </p>
            <ul class="activity-checklist">
              <li>
                <span class="check-bullet">✓</span>
                <span>Juegos de lógica y puzzles para entender ordenación o grafos sin necesidad de ordenador.</span>
              </li>
              <li>
                <span class="check-bullet">✓</span>
                <span>Primeros pasos con Python y C++ a través de ejercicios guiados y accesibles.</span>
              </li>
              <li>
                <span class="check-bullet">✓</span>
                <span>Charlas sobre los estudios de informática y la vida universitaria en Oviedo.</span>
              </li>
            </ul>
            <div style="margin-top: 1.5rem;">
              <a href="/actividades/talleres-stem" class="btn-secondary" style="font-size: 0.82rem; padding: 0.5rem 1rem;">
                Solicitar taller para tu centro &rarr;
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- SECCIÓN: PARA EMPRESAS Y PATROCINADORES -->
    <section id="empresas" class="section-padding">
      <div class="container">
        <div class="sponsors-box">
          <div class="sponsors-intro">
            <span class="section-tag">Colaboraciones</span>
            <h2 class="sponsors-title">Colabora con la asociación</h2>
            <p class="sponsors-desc">
              La participación en certámenes como AdaByron o SWERC requiere financiar desplazamientos, alojamientos e inscripciones. Si tu empresa quiere apoyarnos, podemos organizar actividades conjuntas y dar visibilidad a vuestra marca.
            </p>
            <a href="#contacto" class="btn-primary" style="background: #38bdf8; color: #0f172a;">Contactar con nosotros</a>
          </div>

          <div class="sponsors-pillars">
            <div class="pillar-item">
              <h4 class="pillar-title">Contacto con estudiantes</h4>
              <p class="pillar-text">Conoce a estudiantes de la Escuela de Informática con interés real en algoritmia, optimización y resolución práctica de problemas.</p>
            </div>
            <div class="pillar-item">
              <h4 class="pillar-title">Apoyo en viajes y competiciones</h4>
              <p class="pillar-text">Las aportaciones financian los desplazamientos del equipo a fases regionales y nacionales (AdaByron, SWERC), incluyendo el logo de tu empresa en la equipación.</p>
            </div>
            <div class="pillar-item">
              <h4 class="pillar-title">Charlas y talleres técnicos</h4>
              <p class="pillar-text">Posibilidad de organizar presentaciones técnicas, retos de programación o talleres prácticos conjuntos en el campus de Oviedo.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN: CONTACTO DIRECTO & AUTO-ENVÍO -->
    <section id="contacto" class="section-padding contact-section">
      <div class="container">
        <div class="contact-layout">
          <div class="contact-direct-info">
            <div>
              <span class="section-tag">Contacto</span>
              <h2 class="section-title">Escríbenos</h2>
              <p class="section-lead">
                Si quieres unirte a los entrenamientos, pedir un taller para tu instituto o colaborar con la asociación, escríbenos y te responderemos en pocos días.
              </p>
            </div>

            <div class="direct-channel">
              <div class="channel-label">Correo de la Asociación</div>
              <div class="channel-value">
                <a href="mailto:asociacionuniovi@gmail.com">asociacionuniovi@gmail.com</a>
              </div>
            </div>

            <div class="direct-channel">
              <div class="channel-label">Sede Universitaria</div>
              <div class="channel-value">
                Escuela de Ingeniería Informática<br>
                <span style="font-size: 0.95rem; font-weight: normal; color: var(--ink-secondary);">Campus de los Catalanes · C/ Valdés Salas s/n, 33007 Oviedo</span>
              </div>
            </div>

            <div class="direct-channel">
              <div class="channel-label">Respuesta Estimada</div>
              <div class="channel-value" style="font-size: 0.95rem; color: var(--ink-secondary);">
                Solemos responder en 24 a 48 horas.
              </div>
            </div>
          </div>

          <!-- FORMULARIO INTERACTIVO CON TRANSMISIÓN AUTOMÁTICA -->
          <div class="contact-form-container">
            <form id="contact-form" action="/api/contacto" method="POST" novalidate>
              <!-- Campo trampa invisible para bots (Honeypot) -->
              <input type="text" name="botcheck" style="display: none !important;" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <div class="form-grid">
                <div class="form-group">
                  <label for="nombre" class="form-label">Tu nombre completo <span class="required">*</span></label>
                  <input type="text" id="nombre" name="nombre" class="form-input" placeholder="Ej. Pelayo Álvarez" required>
                </div>

                <div class="form-group">
                  <label for="email" class="form-label">Correo electrónico <span class="required">*</span></label>
                  <input type="email" id="email" name="email" class="form-input" placeholder="nombre@correo.com" required>
                </div>

                <div class="form-group">
                  <label for="categoria" class="form-label">¿Cuál es tu perfil?</label>
                  <select id="categoria" name="categoria" class="form-select">
                    <option value="Estudiante UniOvi">Estudiante de la Universidad de Oviedo</option>
                    <option value="Empresa / Patrocinador">Empresa / Propuesta de Patrocinio</option>
                    <option value="Colegio o Instituto">Colegio / Instituto (Talleres STEM)</option>
                    <option value="Alumni o Mentor">Alumni / Mentor técnico</option>
                    <option value="Otra consulta">Otra consulta general</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="asunto" class="form-label">Asunto breve</label>
                  <input type="text" id="asunto" name="asunto" class="form-input" placeholder="Ej. Unirse al grupo de AdaByron">
                </div>

                <div class="form-group full-width">
                  <label for="mensaje" class="form-label">Tu mensaje <span class="required">*</span></label>
                  <textarea id="mensaje" name="mensaje" class="form-textarea" placeholder="Cuéntanos en qué podemos ayudarte o en qué concurso/actividad te gustaría participar..." required></textarea>
                  <span class="form-helper">Te responderemos directamente a tu correo.</span>
                </div>
              </div>

              <div class="form-submit-row">
                <button type="submit" class="btn-submit">
                  <span>Enviar mensaje</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                  </svg>
                </button>
                <span style="font-size: 0.8rem; color: var(--ink-muted);">Te responderemos lo antes posible.</span>
              </div>

              <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
