---
import Layout from '../layouts/Layout.astro';
import ActiveEvents from '../components/ActiveEvents.astro';
import { getCollection } from 'astro:content';

const allActivities = await getCollection('actividades');
const accessKey =
  import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ||
  import.meta.env.WEB3FORMS_ACCESS_KEY ||
  process.env.PUBLIC_WEB3FORMS_ACCESS_KEY ||
  process.env.WEB3FORMS_ACCESS_KEY ||
  '';
---

<Layout title="PCU UniOvi | Asociación de Programación Competitiva Universitaria">
  <main>
    <!-- SECCIÓN HERO: EDITORIAL CON EVENTOS DE COMPETICIÓN -->
    <section id="hero" class="hero">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-editorial">
            <div class="hero-meta-bar">
              <span class="badge-uniovi">EPI GIJÓN · UNIOVI</span>
              <span class="meta-divider">/</span>
              <span class="meta-status">
                <span class="status-dot"></span> Temporada 2026 Activa
              </span>
            </div>

            <h1 class="hero-title">
              Pensar en <span class="accent-text">O(1)</span>.<br>
              Programación y algoritmia en equipo.
            </h1>

            <p class="hero-description">
              Somos la <strong>Asociación de Programación Competitiva Universitaria (PCU)</strong> de la Universidad de Oviedo. Practicamos estructuras de datos, resolvemos problemas de concurso y preparamos competiciones como AdaByron o SWERC.
            </p>

            <div class="hero-actions">
              <a href="/actividades" class="btn-primary">Ver Actividades</a>
              <a href="/contacto" class="btn-secondary">Unirse a la Asociación</a>
            </div>
          </div>

          <!-- EVENTOS ACTIVOS DE COMPETICIÓN -->
          <ActiveEvents />
        </div>
      </div>
    </section>

    <!-- SECCIÓN: CONCURSOS Y RESULTADOS -->
    <section id="concursos" class="section-padding">
      <div class="container">
        <div class="section-head">
          <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
            <div>
              <h2 class="section-title">Competiciones Oficiales</h2>
              <p class="section-lead">
                Participamos en los principales concursos universitarios de algoritmia por equipos a nivel regional, nacional e internacional.
              </p>
            </div>
            <a href="/actividades" class="btn-secondary">
              Ver todas las actividades ({allActivities.length}) &rarr;
            </a>
          </div>
        </div>

        <!-- RESULTADO DESTACADO EN COMPETICIÓN -->
        <div class="achievement-card" style="margin-top: 0;">
          <div class="achievement-icon-side" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
              <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
              <path d="M4 22h16"></path>
              <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
              <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
              <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
            </svg>
          </div>
          <div class="achievement-body">
            <div class="achievement-header-row">
              <h3 class="achievement-heading">Clasificación a la Final Nacional de AdaByron</h3>
              <span class="achievement-status-tag">Fase Regional Superada</span>
            </div>
            <p class="achievement-text">
              Tras superar la Fase Regional frente a las universidades de la comunidad, nuestro equipo de la Universidad de Oviedo obtuvo la clasificación directa para competir en la <strong>Final Nacional de AdaByron</strong>.
            </p>
            <div class="achievement-meta-strip">
              <span class="meta-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                Formato oficial 3 personas · 1 PC
              </span>
              <span class="meta-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                5 Horas de concurso
              </span>
              <span class="meta-item">EPI Gijón · UniOvi</span>
            </div>
          </div>
          <div class="achievement-cta">
            <a href="/actividades/adabyron" class="btn-achievement">
              <span>Ficha del concurso</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cta-arrow" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN: ACTIVIDADES FORMATIVAS & IMPACTO -->
    <section id="actividades" class="section-padding" style="background-color: var(--bg-surface);">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">Nuestras Actividades</h2>
          <p class="section-lead">
            Formación continua en la EPI de Gijón y orientación en centros educativos de Asturias.
          </p>
        </div>

        <div class="activities-container">
          <!-- Actividad 1: Entrenamientos Técnicos -->
          <article class="activity-pane featured">
            <span class="pane-badge">Formación Continua</span>
            <h3 class="pane-title">Entrenamientos Algorítmicos</h3>
            <p class="pane-text">
              Sesiones prácticas en la EPI de Gijón para resolver problemas de concurso y dominar estructuras de datos avanzadas. Entrenamos la estrategia en equipo bajo el formato oficial de 3 personas y un solo teclado. Actividad abierta a cualquier estudiante de UniOvi con ganas de aprender y competir.
            </p>
            <div style="margin-top: 1.5rem;">
              <a href="/actividades/entrenamientos-semanales" class="btn-secondary">
                Ver temario y detalles &rarr;
              </a>
            </div>
          </article>

          <!-- Actividad 2: Divulgación y Orientación -->
          <article class="activity-pane">
            <span class="pane-badge">Divulgación y Orientación</span>
            <h3 class="pane-title">Charlas Informativas en Institutos</h3>
            <p class="pane-text">
              Acercamos el pensamiento algorítmico y la lógica a estudiantes de secundaria y bachillerato en Asturias. Compartimos nuestra experiencia en las ingenierías de la Universidad de Oviedo y resolvemos dudas sobre la transición a la facultad. Actividad totalmente gratuita para centros educativos.
            </p>
            <div style="margin-top: 1.5rem;">
              <a href="/actividades/charlas-informativas" class="btn-secondary">
                Solicitar charla para tu centro &rarr;
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- SECCIÓN: PARA EMPRESAS Y PATROCINADORES -->
    <section id="empresas" class="section-padding">
      <div class="container">
        <div class="sponsors-box">
          <div class="sponsors-intro">
            <h2 class="sponsors-title">Colabora con la asociación</h2>
            <p class="sponsors-desc">
              Financiamos los desplazamientos del equipo a concursos oficiales mediante acuerdos de patrocinio con empresas tecnológicas. Ofrecemos presencia de marca en equipaciones y campus, junto con acceso directo al mejor talento informático de UniOvi.
            </p>
            <div class="sponsors-actions">
              <a href="/empresas" class="btn-primary">Ver dossier de patrocinio</a>
              <a href="/contacto" class="btn-secondary">Contactar</a>
            </div>
          </div>

          <div class="sponsors-pillars">
            <div class="pillar-item">
              <h3 class="pillar-title">Scouting de talento</h3>
              <p class="pillar-text">Conecta con estudiantes con alto nivel en algoritmia, C++ y resolución práctica de problemas.</p>
            </div>
            <div class="pillar-item">
              <h3 class="pillar-title">Marca en competición</h3>
              <p class="pillar-text">Logotipo en la equipación oficial vestida en las fases nacionales y europeas de AdaByron y SWERC.</p>
            </div>
            <div class="pillar-item">
              <h3 class="pillar-title">Retos y ponencias</h3>
              <p class="pillar-text">Organización conjunta de talleres técnicos, desafíos de programación y charlas en la EPI de Gijón.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN: CONTACTO DIRECTO & AUTO-ENVÍO -->
    <section id="contacto" class="section-padding contact-section">
      <div class="container">
        <div class="contact-layout">
          <div class="contact-direct-info">
            <div>
              <h2 class="section-title">Escríbenos</h2>
              <p class="section-lead">
                ¿Quieres entrenar, pedir una charla para tu centro o colaborar como empresa? Envíanos un mensaje y te responderemos en 24-48 horas.
              </p>
            </div>

            <div class="direct-channel">
              <div class="channel-label">Correo Oficial</div>
              <div class="channel-value">
                <a href="mailto:asociacionuniovi@gmail.com">asociacionuniovi@gmail.com</a>
              </div>
            </div>

            <div class="direct-channel">
              <div class="channel-label">Sede</div>
              <div class="channel-value">
                Escuela Politécnica de Ingeniería (EPI) de Gijón
                <span>Campus de Viesques · 33204 Gijón</span>
              </div>
            </div>
          </div>

          <!-- FORMULARIO INTERACTIVO CON TRANSMISIÓN AUTOMÁTICA -->
          <div class="contact-form-container">
            <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
              <input type="hidden" name="access_key" value={accessKey} />
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <div class="form-grid">
                <div class="form-group">
                  <label for="nombre" class="form-label">Tu nombre <span class="required">*</span></label>
                  <input type="text" id="nombre" name="nombre" class="form-input" placeholder="Ej. Pelayo Álvarez" required>
                </div>

                <div class="form-group">
                  <label for="email" class="form-label">Correo electrónico <span class="required">*</span></label>
                  <input type="email" id="email" name="email" class="form-input" placeholder="nombre@correo.com" required>
                </div>

                <div class="form-group">
                  <label for="categoria" class="form-label">¿Cuál es tu perfil?</label>
                  <select id="categoria" name="categoria" class="form-select">
                    <option value="Estudiante UniOvi">Estudiante UniOvi</option>
                    <option value="Empresa / Patrocinador">Empresa / Patrocinador</option>
                    <option value="Colegio o Instituto">Colegio o Instituto</option>
                    <option value="Otra consulta">Otra consulta general</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="asunto" class="form-label">Asunto breve</label>
                  <input type="text" id="asunto" name="asunto" class="form-input" placeholder="Ej. Unirme a los entrenamientos">
                </div>

                <div class="form-group full-width">
                  <label for="mensaje" class="form-label">Mensaje <span class="required">*</span></label>
                  <textarea id="mensaje" name="mensaje" class="form-textarea" placeholder="Cuéntanos brevemente tu consulta o propuesta..." rows="4" required></textarea>
                </div>
              </div>

              <div class="form-submit-row">
                <button type="submit" class="btn-submit">
                  <span>Enviar mensaje</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                  </svg>
                </button>
                <span style="font-size: 0.8rem; color: var(--ink-muted);">Respuesta en 24-48 horas laborables.</span>
              </div>

              <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
