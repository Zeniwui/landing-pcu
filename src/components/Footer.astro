---
// Footer oficial de PCU UniOvi con acceso a redes sociales y canales de comunidad
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <h3 class="footer-brand-title">PCU Universidad de Oviedo</h3>
        <p class="footer-sub">
          Asociación universitaria dedicada al impulso de la algoritmia de alta competición, olimpiadas científicas y la difusión tecnológica en Asturias.
        </p>

        <!-- CANALES Y REDES SOCIALES COMO ICONOS -->
        <div class="footer-social-strip" aria-label="Canales oficiales y redes sociales">
          <a
            href="https://instagram.com/asociacionpcu"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-btn"
            aria-label="Instagram oficial @asociacionpcu"
            title="Instagram @asociacionpcu"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="footer-col-title">Portal</h4>
        <ul class="footer-links-list">
          <li><a href="/">Inicio</a></li>
          <li><a href="/actividades">Actividades & Concursos</a></li>
          <li><a href="/empresas">Patrocinadores y Empresas</a></li>
          <li><a href="/contacto">Contacto & FAQ</a></li>
        </ul>
      </div>

      <div>
        <h4 class="footer-col-title">Contacto</h4>
        <ul class="footer-links-list">
          <li><a href="mailto:asociacionuniovi@gmail.com">asociacionuniovi@gmail.com</a></li>
          <li><span>Escuela Politécnica de Ingeniería (EPI)</span></li>
          <li><span class="footer-meta-note">Campus de Gijón (Viesques) · 33204</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} Asociación de Programación Competitiva Universitaria · Universidad de Oviedo.</span>
    </div>
  </div>
</footer>
