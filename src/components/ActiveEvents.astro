---
// Componente de Eventos Activos / Competiciones en las que participamos
---

<div class="active-events-box" aria-label="Eventos en los que participamos">
  <div class="events-top">
    <div class="events-status">
      <span class="radar-blink"></span>
      <span>COMPETICIONES // EN CURSO Y PRÓXIMAS</span>
    </div>
    <span class="events-badge-count">Temporada 2026</span>
  </div>

  <div class="events-list">
    <!-- EVENTO 1: HPE CDS TECH CHALLENGE (EN CURSO) -->
    <div class="event-card current">
      <div class="event-card-header">
        <div class="event-title-group">
          <span class="event-indicator active" title="Competición en marcha"></span>
          <div>
            <h3 class="event-title">HPE CDS Tech Challenge</h3>
            <span class="event-sub">La Alianza GreenLake · HPE & AMD</span>
          </div>
        </div>
        <span class="status-pill status-active">
          <span class="live-pulse"></span> En curso
        </span>
      </div>
      <p class="event-desc">
        Competición tecnológica internacional en la que nuestros equipos de UniOvi resuelven retos de IA, analítica de datos, cloud híbrido y ciberseguridad.
      </p>
      <div class="event-meta-footer">
        <span class="meta-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Fase I (Reto 1)
        </span>
        <a href="/actividades/cds-tech-challenge" class="event-link">Ficha CDS Challenge &rarr;</a>
      </div>
    </div>

    <!-- EVENTO 2: SWERC 2026 (18-20 DICIEMBRE 2026) -->
    <div class="event-card upcoming">
      <div class="event-card-header">
        <div class="event-title-group">
          <span class="event-indicator upcoming" title="Próxima competición"></span>
          <div>
            <h3 class="event-title">SWERC 2026</h3>
            <span class="event-sub">ICPC Regional · Multisede Barcelona (UPC FIB)</span>
          </div>
        </div>
        <span class="status-pill status-upcoming">
          18–20 Dic
        </span>
      </div>
      <p class="event-desc">
        Clasificatoria oficial de Europa sudoccidental para el Europe Championship e ICPC World Finals. Tres integrantes por equipo, 1 único PC y 5 horas de algoritmia.
      </p>
      <div class="event-meta-footer">
        <span class="meta-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          18–20 de diciembre de 2026
        </span>
        <a href="/actividades/icpc-swerc" class="event-link">Ficha SWERC &rarr;</a>
      </div>
    </div>
  </div>

  <div class="events-foot">
    <span class="foot-label">Representación UniOvi · EPI Gijón</span>
    <a href="/actividades" class="foot-link">Ver todas las actividades &rarr;</a>
  </div>
</div>

<style>
  .active-events-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .active-events-box:hover {
    box-shadow: var(--shadow-elevated);
    border-color: var(--border-strong);
  }

  .events-top {
    background: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-hairline);
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .events-status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink-secondary);
    font-weight: 600;
    letter-spacing: 0.04em;
    font-size: 0.78rem;
  }

  .radar-blink {
    width: 8px;
    height: 8px;
    background: var(--verdict-ac);
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
    animation: blinkGlow 2s infinite;
  }

  @keyframes blinkGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.85); }
  }

  @media (prefers-reduced-motion: reduce) {
    .radar-blink, .live-pulse {
      animation: none !important;
      opacity: 1 !important;
    }
  }

  .events-badge-count {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--uniovi-blue);
    background: var(--uniovi-blue-tint);
    border: 1px solid rgba(29, 78, 216, 0.15);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
  }

  .events-list {
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--bg-surface);
  }

  .event-card {
    background: var(--bg-page);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
    transition: all 0.15s ease;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .event-card:hover {
    background: #ffffff;
    border-color: var(--border-strong);
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
  }

  .event-card.current {
    background: linear-gradient(135deg, rgba(236, 253, 245, 0.45) 0%, #ffffff 100%);
    border-color: rgba(5, 150, 105, 0.24);
  }

  .event-card.upcoming {
    background: linear-gradient(135deg, rgba(239, 246, 255, 0.5) 0%, #ffffff 100%);
    border-color: rgba(29, 78, 216, 0.22);
  }

  .event-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .event-title-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .event-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .event-indicator.active {
    background-color: var(--verdict-ac);
    box-shadow: 0 0 0 2px var(--verdict-ac-bg);
  }

  .event-indicator.upcoming {
    background-color: var(--uniovi-blue);
    box-shadow: 0 0 0 2px var(--uniovi-blue-tint);
  }

  .event-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink-primary);
    line-height: 1.2;
    margin: 0;
  }

  .event-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin-top: 0.15rem;
  }

  .status-pill {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .status-active {
    color: var(--verdict-ac);
    background: var(--verdict-ac-bg);
    border: 1px solid rgba(5, 150, 105, 0.25);
  }

  .live-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--verdict-ac);
    display: inline-block;
    animation: blinkGlow 1.5s infinite;
  }

  .status-upcoming {
    color: var(--uniovi-blue);
    background: var(--uniovi-blue-tint);
    border: 1px solid rgba(29, 78, 216, 0.2);
  }

  .event-desc {
    font-size: 1rem;
    color: var(--ink-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .event-meta-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.45rem;
    border-top: 1px solid var(--border-hairline);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .meta-tag {
    color: var(--ink-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .event-link {
    color: var(--uniovi-blue);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .event-link:hover {
    color: var(--uniovi-blue-hover);
    text-decoration: underline;
  }

  .events-foot {
    padding: 0.75rem 1.25rem;
    background: var(--bg-surface-elevated);
    border-top: 1px solid var(--border-hairline);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .foot-label {
    color: var(--ink-muted);
  }

  .foot-link {
    color: var(--uniovi-blue);
    font-weight: 600;
    text-decoration: none;
  }

  .foot-link:hover {
    text-decoration: underline;
  }
</style>
