# ==============================================================
# VARIABLES DE ENTORNO — PCU UNIOVI PORTAL WEB
# ==============================================================
# Para desarrollo en local:
# 1. Copia este archivo como `.env` en la raíz del proyecto.
# 2. Pega tu clave de Web3Forms (obtenida gratis en https://web3forms.com con asociacionuniovi@gmail.com).
#
# Para producción en Vercel:
# Ve a Settings > Environment Variables en Vercel y añade:
# Nombre: WEB3FORMS_ACCESS_KEY
# Valor:  tu_clave_aqui
# ==============================================================

WEB3FORMS_ACCESS_KEY=
